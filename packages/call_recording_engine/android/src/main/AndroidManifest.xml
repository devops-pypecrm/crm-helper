<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.pypecrm.call_recording_engine">

    <application>
        <!-- These components merge into the host app's manifest
             (Dad-call-recorder, see its AndroidManifest.xml for the full
             permission list they rely on). The receiver/services only ever
             act if EngineStats.isMonitoringEnabled is true — set via
             CallRecordingEngine.startMonitoring()/stopMonitoring() from
             Dart, so a fresh install with no login/onboarding done yet does
             nothing even though the receiver is always registered. -->

        <receiver
            android:name=".receivers.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- `dataSync`, NOT `phoneCall` — confirmed on a real device that
             `phoneCall` requires MANAGE_OWN_CALLS or the default-dialer
             role on Android 14+ (this app is neither, it only monitors
             calls, never manages them), which crashed this service with a
             SecurityException on every single call-end. See
             CallMonitorService.onStartCommand's doc comment. -->
        <service
            android:name=".service.CallMonitorService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>

</manifest>
