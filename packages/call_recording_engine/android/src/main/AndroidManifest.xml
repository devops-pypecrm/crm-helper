<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.pypecrm.call_recording_engine">

    <application>
        <!-- These components merge into the host app's manifest
             (Dad-call-recorder, see its AndroidManifest.xml for the full
             permission list they rely on). The receiver/services only ever
             act if EngineStats.isMonitoringEnabled is true — set via
             CallRecordingEngine.startMonitoring()/stopMonitoring() from
             Dart, so a fresh install with no login/onboarding done yet does
             nothing even though the receiver is always registered. -->

        <receiver
            android:name=".receivers.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- `dataSync|microphone`, NOT `phoneCall` — confirmed on a real
             device that `phoneCall` requires MANAGE_OWN_CALLS or the
             default-dialer role on Android 14+ (this app is neither, it
             only monitors calls, never manages them), which crashed this
             service with a SecurityException on every single call-end.
             See CallMonitorService.onStartCommand's doc comment. -->
        <service
            android:name=".service.CallMonitorService"
            android:foregroundServiceType="dataSync|microphone"
            android:exported="false" />

        <!-- Tier 3's own service, deliberately NOT sharing
             CallMonitorService's foregroundServiceType — see
             ProjectionCaptureService's doc comment for why combining them
             would risk crashing normal (non-Tier-3) call monitoring on
             Android 14+. -->
        <service
            android:name=".service.ProjectionCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- The real default-Phone-app integration: once this app holds
             RoleManager.ROLE_DIALER, Android delivers the actual Call
             objects (created by the system's own SIM-backed telephony
             ConnectionService) here — see PypeInCallService's doc comment
             for why this replaced an earlier self-managed
             ConnectionService, which could never represent a real call.
             Only the OS may bind to an InCallService
             (BIND_INCALL_SERVICE); IN_CALL_SERVICE_UI marks this as the
             one that should render the call UI (required to be selectable
             as the default dialer). -->
        <service
            android:name=".dialer.PypeInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Tier 2: merely existing and being enabled by the user in
             system Settings > Accessibility unlocks
             MediaRecorder.AudioSource.VOICE_RECOGNITION as an in-call audio
             source on many Android versions — see
             CallRecordingAccessibilityService's doc comment. Only the
             system may bind to it (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".accessibility.CallRecordingAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Reads WhatsApp notification content (contact + message preview,
             never the full chat) to log inbound replies to the CRM — see
             WhatsAppSyncListenerService's doc comment for why this lives
             here and never in Dad-mobile (the Play Store app). Only the
             system may bind to it (BIND_NOTIFICATION_LISTENER_SERVICE);
             the user grants "Notification access" by hand in system
             Settings, the same one-way-only pattern as the accessibility
             service above. -->
        <service
            android:name=".service.WhatsAppSyncListenerService"
            android:label="PypeCRM WhatsApp Sync"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
