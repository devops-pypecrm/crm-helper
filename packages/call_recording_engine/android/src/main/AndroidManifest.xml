<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.pypecrm.call_recording_engine">

    <application>
        <!-- These components merge into the host app's manifest
             (Dad-call-recorder, see its AndroidManifest.xml for the full
             permission list they rely on). The receiver/services only ever
             act if EngineStats.isMonitoringEnabled is true — set via
             CallRecordingEngine.startMonitoring()/stopMonitoring() from
             Dart, so a fresh install with no login/onboarding done yet does
             nothing even though the receiver is always registered. -->

        <receiver
            android:name=".receivers.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- `dataSync|microphone`, NOT `phoneCall` — confirmed on a real
             device that `phoneCall` requires MANAGE_OWN_CALLS or the
             default-dialer role on Android 14+ (this app is neither, it
             only monitors calls, never manages them), which crashed this
             service with a SecurityException on every single call-end.
             See CallMonitorService.onStartCommand's doc comment. -->
        <service
            android:name=".service.CallMonitorService"
            android:foregroundServiceType="dataSync|microphone"
            android:exported="false" />

        <!-- Tier 3's own service, deliberately NOT sharing
             CallMonitorService's foregroundServiceType — see
             ProjectionCaptureService's doc comment for why combining them
             would risk crashing normal (non-Tier-3) call monitoring on
             Android 14+. -->
        <service
            android:name=".service.ProjectionCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- Milestone 1 POC only — the InCallService making the
             conference-recording experiment possible at all (see
             telecom/PypeInCallService.kt's doc comment). Only acts when
             PocConfig.role is set; a fresh install with no POC role chosen
             does nothing here even though ROLE_DIALER eligibility requires
             this to always be declared. `IN_CALL_SERVICE_UI=true` marks
             this as providing the primary in-call UI, a real requirement
             for RoleManager.ROLE_DIALER eligibility, not optional. -->
        <service
            android:name=".telecom.PypeInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Milestone 1 POC only — a no-op activity that exists solely to
             satisfy RoleManager.ROLE_DIALER's requirement that a candidate
             app handle ACTION_DIAL/ACTION_VIEW(tel:). See
             telecom/PocDialActivity.kt's doc comment. -->
        <activity
            android:name=".telecom.PocDialActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Tier 2: merely existing and being enabled by the user in
             system Settings > Accessibility unlocks
             MediaRecorder.AudioSource.VOICE_RECOGNITION as an in-call audio
             source on many Android versions — see
             CallRecordingAccessibilityService's doc comment. Only the
             system may bind to it (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".accessibility.CallRecordingAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
